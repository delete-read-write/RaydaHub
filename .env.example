# src/raydahub/core/config/settings.py::AppSettings
APP_SERVICE_NAME=RaydaHub
APP_SERVICE_VERSION=0.1.0

# src/raydahub/core/config/settings.py::LoggingSettings
LOGGING_LEVEL=INFO
LOGGING_FMT="[%(asctime)s.%(msecs)03d] [%(threadName)s] %(funcName)20s %(module)s:%(lineno)d %(levelname)-8s - %(message)s"
LOGGING_DATEFMT="%Y-%m-%d %H:%M:%S"

# src/raydahub/core/config/settings.py::FastAPISettings
FASTAPI_DEBUG=false
FASTAPI_DOCS_URL=/docs
FASTAPI_REDOC_URL=/redoc
FASTAPI_OPENAPI_URL=/openapi.json

# src/raydahub/core/config/settings.py::SQLASettings
SQLA_ECHO=false
SQLA_ECHO_POOL=false
SQLA_POOL_SIZE=15
SQLA_MAX_OVERFLOW=10
SQLA_CONNECT_TIMEOUT_S=5

# src/raydahub/core/config/settings.py::PostgresSettings
POSTGRES_USER=raydahub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=raydahub

# docker-entrypoint.py
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
UVICORN_ROOT_PATH=
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1
UVICORN_SERVER_HEADER=false
